{
  "name": "pocketwave",
  "productName": "Pocketwave",
  "version": "1.2.0",
  "description": "Pocketwave - a portable, offline music player for Windows, Linux and macOS",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": "Pocketwave Authors",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "node scripts/build.js",
    "build:win": "node scripts/build.js --platform=win32 --arch=x64",
    "build:linux": "node scripts/build.js --platform=linux",
    "build:mac": "node scripts/build.js --platform=darwin",
    "build:win:latest": "node scripts/build.js --platform=win32 --arch=x64 --electron=45.2.1"
  },
  "dependencies": {
    "music-metadata": "7.14.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "electron": "33.4.11",
    "resedit": "^2.0.3"
  }
}
